# ------------------------------------------------------------------------------
# 🐳 Dockerfile - Nautilus Dev Environment (Ubuntu 22.04)
# ------------------------------------------------------------------------------

FROM ubuntu:22.04

# ------------------------------------------------------------------------------
# 🔧 Environment Variables
# ------------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive
ENV BUILD_MODE=release
ENV RUST_BACKTRACE=1
ENV CARGO_INCREMENTAL=1
ENV CC="clang"
ENV CXX="clang++"
ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

# ------------------------------------------------------------------------------
# 📦 Install System Dependencies
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    clang \
    git \
    pkg-config \
    make \
    capnproto \
    libcapnp-dev \
    gcc-aarch64-linux-gnu \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    python3-pip \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 🦀 Install Rust Toolchain
# ------------------------------------------------------------------------------
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && rustup component add clippy rustfmt

# ------------------------------------------------------------------------------
# 🐍 Install uv + Python (via uv)
# ------------------------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Install latest Python (3.13) via uv
RUN uv python install

# ------------------------------------------------------------------------------
# 📂 Set Working Directory
# ------------------------------------------------------------------------------
WORKDIR /workspace

# ------------------------------------------------------------------------------
# 📄 Copy Toolchain and Metadata
# ------------------------------------------------------------------------------
COPY ../scripts/rust-toolchain.sh scripts/
COPY ../Cargo.toml Cargo.lock pyproject.toml rust-toolchain.toml ./

# ------------------------------------------------------------------------------
# ⚙️ Install Rust Toolchain from Project File
# ------------------------------------------------------------------------------
RUN bash scripts/rust-toolchain.sh > /tmp/toolchain.txt && \
    TOOLCHAIN=$(cat /tmp/toolchain.txt) && \
    rustup toolchain install "$TOOLCHAIN" && \
    rustup default "$TOOLCHAIN"

# ------------------------------------------------------------------------------
# 🚀 Entrypoint
# ------------------------------------------------------------------------------
COPY .docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
